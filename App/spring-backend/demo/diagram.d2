vars: {
  d2-config: {
    theme-id: 4 # Grape Light Theme
    pad: 10 # Decreased overall canvas padding
  }
}

direction: right

# --- Client Layer ---
frontend: Web Client {
  shape: person
  style: {
    fill: "#f3e8ff"
    stroke: "#7e22ce"
  }
}

# --- AWS Cloud Infrastructure ---
aws: AWS Cloud Infrastructure {
  style: {
    stroke-dash: 4
    fill: "#faf5ff"
    stroke: "#9333ea"
  }

  direction: right

  # Column 1: Application Services
  services: Application Services {
    direction: down

    style: {
      fill: "#ffffff"
      stroke: "#d8b4fe"
    }

    ec2-backend: EC2: Spring API {
      shape: rectangle
      style: {
        fill: "#f3e8ff"
        stroke: "#6b21a8"
      }
    }

    ec2-image-proc: "EC2: C# Image Processor" {
      shape: rectangle
      style: {
        fill: "#fce7f3"
        stroke: "#be185d"
      }
    }

    ec2-backend -> ec2-image-proc: Filter Requests
  }

  # Column 2: Storage & Persistence
  storage: Storage & Persistence {
    direction: down

    style: {
      fill: "#ffffff"
      stroke: "#d8b4fe"
    }

    ec2-db: EC2: Database {
      shape: cylinder
      style: {
        fill: "#ede9fe"
        stroke: "#4338ca"
      }
    }

    s3-bucket: Amazon S3: Media Bucket {
      shape: cloud
      style: {
        fill: "#fae8ff"
        stroke: "#a21caf"
      }
    }
  }
}

# --- Connections Across Containers ---
frontend -> aws.services.ec2-backend: REST API

# Shortened edge labels reduce spacing dramatically
aws.services.ec2-backend -> aws.storage.ec2-db: Read/Write
aws.services.ec2-backend -> aws.storage.s3-bucket: Uploads
aws.services.ec2-image-proc -> aws.storage.s3-bucket: Processed Media